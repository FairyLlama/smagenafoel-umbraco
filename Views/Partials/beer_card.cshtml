@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.PublishedCache
@using Umbraco.Cms.Core.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.BeerPage>
@inject ITagQuery _tagQuery;


@{
    var beers = Model.Children<ContentModels.BeerEntry>();
    var allContentTags = _tagQuery.GetAllContentTags();
}

<div class="beer-toggle">
    | <span class="clickable" onclick="clearSelections()"> Alle </span> |
    @foreach (var tag in allContentTags)
    {
        string passParam = $"'{tag.Text}'";
        <span class="clickable" onclick="toggleBeerItems(@passParam)"> @tag.Text | </span>
    }
</div>


<div class="card-container">
    @foreach (var item in beers)
    {
        <div class="beer-card">
            <a href="@item.Url()">
                <img src="@Url.GetCropUrl(item.MainImage, "Thumbnail")" />
            </a>


            <p class="beer-title"> @item.HeaderContent </p>
            <p class="beer-sum">@item.Summary</p>
            <p class="beer-tag" data-cats="@String.Join(" ", item.Categories)"> @String.Join(" | ", item.Categories) </p>
        </div>
    }

</div>




<script type="text/javascript">
    const clearSelections = () => {
        const targets = document.querySelectorAll('[data-cats]');
        
        targets.forEach(t => {
            if (t.parentElement.style.display === 'none')
                t.parentElement.style.display = 'block';
        });
    };

    const toggleBeerItems = (tag) => {
        console.log("blog item toggle for " + tag);
        let targets = document.querySelectorAll('[data-cats]');

        targets.forEach(t => {
            const x = t.parentElement;
            if (x.style.display === 'none') x.style.display = 'block';
        });

        let newTargets = [];
        targets.forEach(t => {
            if (!t.innerText.toLowerCase().includes(tag.toLowerCase())) {
                newTargets = [...newTargets, t]
            }
        });

        newTargets.forEach(t => {
            const x = t.parentElement;
            x.style.display = x.style.display === 'none' ? 'block' : 'none';
        });
    }
</script>