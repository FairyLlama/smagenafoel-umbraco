@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.ContentPage>
@inject Umbraco.Cms.Web.Common.UmbracoHelper umbracoHelper
@{
	Layout = "master.cshtml";
	var siteSection = Model.AncestorOrSelf(2);
	var selection = siteSection.Children.Where(x => x.IsVisible());
}

<!DOCTYPE html>
<html>

<head>
	<link rel="stylesheet" href="@Url.Content("~/css/Homepage.css")" />
</head>

@await Html.PartialAsync("header")
@Model.Value("mainContent")
@* @await Html.PartialAsync("beer_card") *@
<div class="card-container">
	@foreach (var item in selection)
	{
		<div class="beer-card">
			@* <p>@item.MainImage</p> *@
			<p> @item.Value("headerContent") </p>

		</div>
	}
</div>


</html>
